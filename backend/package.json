{
  "name": "jcb-cmms-api",
  "version": "1.0.0",
  "description": "JCB Smart Machine Maintenance Management System Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test dist/modules/inventory/inventory.test.js dist/modules/auth/auth.test.js dist/modules/breakdowns/breakdowns.test.js dist/modules/work-orders/work-orders.test.js dist/modules/procurement/procurement.test.js dist/modules/downtime/downtime.test.js dist/modules/pm/pm.test.js",
    "test:auth": "node --test dist/modules/auth/auth.test.js",
    "test:inventory": "node --test dist/modules/inventory/inventory.test.js",
    "test:breakdowns": "node --test dist/modules/breakdowns/breakdowns.test.js",
    "test:work-orders": "node --test dist/modules/work-orders/work-orders.test.js",
    "test:procurement": "node --test dist/modules/procurement/procurement.test.js",
    "test:downtime": "node --test dist/modules/downtime/downtime.test.js",
    "test:pm": "node --test dist/modules/pm/pm.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
